// review-service: the one owner of review data.
//
// Ported from gostyle-platform's storefront_review* tables (migrations
// 20260807120000 and 20260808120000), with three deliberate changes, each
// explained where it lands:
//   1. booking_source joins every booking key (two systems mint booking ids)
//   2. CHECK constraints back the domain rules (no other code shares this DB)
//   3. the rating summary is STORED (customer-api cannot run the query)
//
// What Prisma cannot express lives as hand-written SQL in the migration:
// CHECKs, the partial unique index on open reports, and the partial index on
// unpublished outbox rows. Never let a `migrate dev` drop them.
//
// NO FOREIGN KEYS TO OTHER SERVICES' IDS. tenant, storefront, branch, booking,
// customer and staff ids are bare @db.Uuid columns. The only foreign keys are
// between this service's own tables.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // REQUIRED. Prisma 7 generates ESM by default and Nest compiles to CommonJS.
  moduleFormat        = "cjs"
  // Bare specifiers: tsc never rewrites "./internal/class.ts", so node would
  // look for a .ts file that was compiled away.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ============================================================ messaging

/// Events waiting to leave, written in the same transaction as the change.
/// Same shape as booking-api's event_outbox, plus tenant_id and a retry clock.
model OutboxEvent {
  id String @id @db.Uuid

  tenantId      String @map("tenant_id") @db.Uuid
  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id") @db.Uuid
  eventType     String @map("event_type")
  payload       Json

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0) @db.SmallInt
  lastError     String?   @map("last_error")
  /// When the relay may try this row next. NULL means now. Also the claim
  /// lease that keeps two replicas off one row.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)

  // The relay's claim index is PARTIAL (WHERE published_at IS NULL):
  // outbox_event_unpublished_idx, hand-written in the migration.
  @@index([aggregateType, aggregateId], map: "outbox_event_aggregate_idx")
  @@map("outbox_event")
}

/// Events already handled. The primary key is what makes every consumer safe
/// to call twice: the row is written first, and a redelivery finds it.
///
/// tenant_id is NULLABLE here and only here: the row records that an event
/// arrived, which can be before (or instead of) any tenant being resolvable
/// from it, e.g. a malformed event that is recorded and ignored.
model InboxEvent {
  source    String
  eventId   String  @map("event_id")
  eventType String  @map("event_type")
  tenantId  String? @map("tenant_id") @db.Uuid
  /// What handling it decided: invite_minted, already_invited, no_storefront...
  outcome   String

  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([source, eventId], map: "inbox_event_pkey")
  @@map("inbox_event")
}
