# review-service. Copy to .env for local development; NEVER commit .env.
# Every variable without a "(default ...)" note is REQUIRED: boot fails,
# naming every missing one, until it is set.
# Secrets also accept <NAME>_FILE pointing at a mounted file (Docker secrets).

NODE_ENV=development
PORT=3352
# LOG_LEVEL=info                      (default info)
# TRUST_PROXY_HOPS=0                  (default 0; 1 behind nginx)

# ─── storage ──────────────────────────────────────────────────────────────
# Host side of the compose stack: review-db on 127.0.0.1:5435.
DATABASE_URL=postgresql://review:change-me-db@127.0.0.1:5435/review
REDIS_HOST=127.0.0.1
REDIS_PORT=6382
REDIS_PASSWORD=change-me-redis
# The compose file reads these two to start the containers:
REVIEW_DB_PASSWORD=change-me-db
REVIEW_REDIS_PASSWORD=change-me-redis

# ─── people: platform staff JWTs ──────────────────────────────────────────
# The SAME secret gostyle-api signs access tokens with (HS256, issuer gostyle-api).
JWT_ACCESS_SECRET=change-me-same-as-gostyle-api
PLATFORM_API_URL=http://127.0.0.1:3000
# PERMISSION_CACHE_TTL_MS=30000       (default 30000)

# ─── services calling us: one key per caller (x-service-key) ──────────────
# All four must differ. At least 32 characters in production.
SERVICE_KEY_PLATFORM=change-me-platform-calls-review
SERVICE_KEY_BOOKING_API=change-me-booking-api-calls-review
SERVICE_KEY_CUSTOMER_API=change-me-customer-api-calls-review
SERVICE_KEY_OPS=change-me-ops-calls-review

# ─── services we call ─────────────────────────────────────────────────────
# gostyle-api's internal lookups (storefront by branch, customer contact).
PLATFORM_INTERNAL_KEY=change-me-review-calls-platform
# customer-api receives rating.summary.changed.v1.
CUSTOMER_API_URL=http://127.0.0.1:8000
CUSTOMER_API_KEY=change-me-review-calls-customer-api
# push-notification-service, for "the salon replied".
PUSH_API_URL=http://127.0.0.1:3351
PUSH_API_KEY=change-me-push-api-key
# HTTP_TIMEOUT_MS=5000                (default 5000)

# ─── invites ──────────────────────────────────────────────────────────────
# The review form. The link is <base>/<token>.
REVIEW_PUBLIC_BASE_URL=http://127.0.0.1:5173/review
# log: write "would send" with a masked phone, never the link. whatsapp: Cloud API.
INVITE_SENDER=log
# INVITE_SEND_RETRY_ATTEMPTS=5        (default 5; 0 = never resend, as the platform)
# Only when INVITE_SENDER=whatsapp:
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_INVITE_TEMPLATE_EN=
# WHATSAPP_INVITE_TEMPLATE_AR=
# WHATSAPP_API_VERSION=v23.0          (default v23.0)

# ─── jobs ─────────────────────────────────────────────────────────────────
# QUEUE_PREFIX=review                 (default review; BullMQ key prefix)
# OUTBOX_RELAY_INTERVAL_MS=1000       (default 1000)
# RECOMPUTE_CRON=0 3 * * *            (default 03:00 daily)
# RECOMPUTE_TZ=UTC                    (default UTC)

# ─── retention: config only, NOTHING is deleted yet ───────────────────────
# RETENTION_EXPIRED_INVITE_DAYS=90    (default 90)
# RETENTION_CLOSED_REPORT_DAYS=365    (default 365)

# Only for `yarn prisma:check`: a throwaway database Prisma replays migrations into.
SHADOW_DATABASE_URL=postgresql://review:change-me-db@127.0.0.1:5435/review_shadow
